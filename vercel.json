{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.solunit.es" }],
      "destination": "https://solunit.es/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.solunit.es" }],
      "destination": "https://solunit.es/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
